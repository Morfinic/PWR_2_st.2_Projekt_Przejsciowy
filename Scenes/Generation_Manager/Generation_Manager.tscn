[sub_resource type="GDScript" id="GDScript_q2ugx"]
script/source = "extends CanvasLayer


func _ready() -> void:
	self.visible = false


func _unhandled_key_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"open_pdg_menu\"):
		self.visible = !self.visible
	get_viewport().set_input_as_handled()
"

[sub_resource type="GDScript" id="GDScript_uumgm"]
script/source = "extends Camera2D


var zoomValue: float = 1
var cameraMove: bool = false


var _previousPosition: Vector2 = Vector2(0, 0)
var _moveCamera: bool = false
var _startPosition: Vector2

func _input(event: InputEvent) -> void:
	if event.is_action(\"zoom_in\"):
		zoomValue += 0.1
	elif event.is_action(\"zoom_out\"):
		zoomValue -= 0.1

#dziala jakos i rusza kamere
func _unhandled_input(event: InputEvent):
	if event is InputEventMouseButton && event.button_index == MOUSE_BUTTON_LEFT:
		get_viewport().set_input_as_handled()
		if event.is_pressed():
			_previousPosition = event.position
			_moveCamera = true
			_startPosition = position
		else:
			_moveCamera = false
	elif event is InputEventMouseMotion && _moveCamera:
		get_viewport().set_input_as_handled()
		position += (_previousPosition - event.position) * (1 / zoomValue)
		_previousPosition = event.position
		

func _process(delta: float) -> void:
	zoomValue = clampf(zoomValue, 1, 3)
	zoom = Vector2(zoomValue, zoomValue)
"

