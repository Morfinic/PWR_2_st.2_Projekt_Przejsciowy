[sub_resource type="GDScript" id="GDScript_1kjex"]
script/source = "extends Node2D

# Levels
const WALKER_LEVEL = preload(\"uid://crq1lrivv0yii\")
const BSP = preload(\"uid://b5aget88j8kx8\")
const CELLULAR_AUTOMATA = preload(\"uid://jjonoqkeahe3\")
const MAZE = preload(\"uid://bh50pgygh8vwk\")
const GENETIC = preload(\"uid://by14pdhds5xd3\")
# Tilessets
const MAIN_TILES = preload(\"uid://d3undk2ko1jv\")
const MAZE_TILES = preload(\"uid://bdc2t5y02k4fw\")


@onready var gen_alg_holder: Node2D = $Gen_Alg_Holder
@onready var ground: TileMapLayer = $TileLayerHolder/Ground


var map := []


func prepare_level_gen(alg_selected, level_size):
	print(alg_selected, \", \", level_size)
	ground.clear()
	
	if alg_selected == 3:
		ground.tile_set = MAZE_TILES
	else:
		ground.tile_set = MAIN_TILES

	match alg_selected:
		# Drunken Walker
		0:
			gen_alg_holder.add_child(
				WALKER_LEVEL.instantiate().with_data(level_size)
			)
		# BSP
		1:
			gen_alg_holder.add_child(
				BSP.instantiate().with_data(level_size)
			)
		# CA
		2:
			gen_alg_holder.add_child(
				CELLULAR_AUTOMATA.instantiate().with_data(level_size)
			)
		# Maze
		3:
			gen_alg_holder.add_child(
				MAZE.instantiate().with_data(level_size)
			)
		4:
			gen_alg_holder.add_child(
				GENETIC.instantiate().with_data(level_size)
			)

	var alg_node = gen_alg_holder.get_child(0)

	var start = Time.get_ticks_usec()
	map = alg_node.generate_level()
	var end = Time.get_ticks_usec()
	var work_time = (end-start)*0.001

	print(\"Generated in %s ms.\" % work_time)

	ground.set_cells_terrain_connect(
		map, 0, 0
	)

	alg_node.queue_free()
"

[sub_resource type="GDScript" id="GDScript_q2ugx"]
script/source = "extends CanvasLayer

signal generate_level


@onready var alg_sel: OptionButton = $HSplitter/Left/Menu/ColorRect/Settings_VContainer/Alg_Select/VBoxContainer/Algorithm_Select
@onready var width_edit: SpinBox = $HSplitter/Left/Menu/ColorRect/Settings_VContainer/Alg_Select/VBoxContainer/HBoxContainer/Width_Edit
@onready var height_edit: SpinBox = $HSplitter/Left/Menu/ColorRect/Settings_VContainer/Alg_Select/VBoxContainer/HBoxContainer/Height_Edit
@onready var gen_alg_holder: Node2D = $\"../Gen_Alg_Holder\"


func _ready() -> void:
	self.visible = false
	generate_level.connect(owner.prepare_level_gen)


func _unhandled_key_input(event: InputEvent) -> void:
	if event.is_action_pressed(\"open_pdg_menu\"):
		self.visible = !self.visible
	get_viewport().set_input_as_handled()


func _on_generate_btn_pressed() -> void:
	var alg_selected = alg_sel.selected
	var level_size = Vector2i(
		width_edit.value, height_edit.value
	)

	generate_level.emit(alg_selected, level_size)

	$\"../Camera\".position = Vector2(
		width_edit.value * 8,
		height_edit.value * 8
	)
"

[sub_resource type="GDScript" id="GDScript_uumgm"]
script/source = "extends Camera2D


var zoomValue: float = 1
var cameraMove: bool = false
var l_size := Vector2(50, 50)

var _previousPosition: Vector2 = Vector2(0, 0)
var _moveCamera: bool = false
var _startPosition: Vector2

func _input(event: InputEvent) -> void:
	if event.is_action(\"zoom_in\"):
		zoomValue += 0.025
	elif event.is_action(\"zoom_out\"):
		zoomValue -= 0.025

#dziala jakos i rusza kamere
func _unhandled_input(event: InputEvent):
	if event is InputEventMouseButton && event.button_index == MOUSE_BUTTON_LEFT:
		get_viewport().set_input_as_handled()
		if event.is_pressed():
			_previousPosition = event.position
			_moveCamera = true
			_startPosition = position
		else:
			_moveCamera = false
	elif event is InputEventMouseMotion && _moveCamera:
		get_viewport().set_input_as_handled()
		position += (_previousPosition - event.position) * (1 / zoomValue)
		_previousPosition = event.position
		

func _process(delta: float) -> void:
	zoomValue = clampf(zoomValue, 0, 3)
	zoom = Vector2(zoomValue, zoomValue)
"

