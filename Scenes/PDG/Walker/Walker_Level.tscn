[sub_resource type="GDScript" id="GDScript_v3aoi"]
script/source = "extends Node
class_name WalkerLevel


var starting_pos: Vector2
var level_size: Vector2i


func with_data(level_size) -> WalkerLevel:
	self.level_size = level_size
	return self


func generate_level():
	starting_pos = level_size / 2
	var walker = Walker.new(starting_pos, level_size)
	var steps_amount = floor(level_size.x * level_size.y) * 0.75
	
	var map = walker.walk(steps_amount)
	walker.queue_free()
	
	return map
"

[node name="WalkerLevel" type="Node"]
script = SubResource("GDScript_v3aoi")
