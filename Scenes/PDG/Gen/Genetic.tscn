script/source = "extends Node
class_name Genetic


var level_size
var pop_size: int = 5
var gens: int = 3
var mut_rate: float = 0.01
var cross_rate: float = 0.45
var elit_count: int = 2
var floor_target: float = 0.5

class Pop:
	var grid: Array = []
	var fitness: float = 0.0

var pops: Array[Pop] = []


func with_data(level_size) -> Genetic:
	self.level_size = level_size
	return self


func generate_level():
	randomize()

	_init_pops()
	for i in gens:
		_eval_fit()
		var new_pop = _sel_and_breed()
		pops = new_pop
		#print(\"Generation %d completed\" % i)
	_eval_fit()
	pops.sort_custom(func(a, b): return a.fitness > b.fitness)

	return _create_map(pops[0].grid)


func _init_pops():
	pops.resize(pop_size)
	#for i in pop_size:
		#var pop = Pop.new()
		#pop.grid = _rand_grid()
		#pops.append(pop)
	var task_id = WorkerThreadPool.add_group_task(
		func(index):
			var pop = Pop.new()
			pop.grid = _rand_grid()
			pops[index] = pop,
		pop_size
	)
	WorkerThreadPool.wait_for_group_task_completion(task_id)


func _create_map(pop_grid):
	var grid: Array[Vector2i] = []
	for x in range(level_size.x):
		for y in range(level_size.y):
			if pop_grid[x][y] == 1:
				grid.append(Vector2i(x, y))

	return grid

func count_walls(x, y, area, grid):
	var cnt = 0

	for i in range(-area, area + 1):
		for j in range(-area, area + 1):
			if i == 0 and j == 0:
				continue

			var nx = x + i
			var ny = y + j

			if nx < 0 or nx >= level_size.x or ny < 0 or ny >= level_size.y:
				cnt += 1
			elif grid[nx][ny]:
				cnt += 1

	return cnt


func _rand_grid():
	var rng = RandomNumberGenerator.new()
	rng.randomize()
	
	var grid := []
	for x in range(level_size.x):
		var column = []
		column.resize(level_size.y)
		column.fill(0)
		grid.append(column)
	
	var root = TreeNode.new(Vector2i(1,1), Vector2i(level_size.x-2, level_size.y-2))
	root.split(4)
	
	var leaves = root.return_leaves()
	for leaf in leaves:
		var max_w = max(4, leaf.size.x - 2)
		var max_h = max(4, leaf.size.y - 2)
		var room_w = rng.randi_range(4, max_w)
		var room_h = rng.randi_range(4, max_h)
		var room_x = leaf.position.x + rng.randi_range(1, max(1, leaf.size.x - room_w - 1))
		var room_y = leaf.position.y + rng.randi_range(1, max(1, leaf.size.y - room_h - 1))

		for x in range(room_x, room_x + room_w):
			for y in range(room_y, room_y + room_h):
				if x < level_size.x - 1 and y < level_size.y - 1:
					grid[x][y] = 1

	_generate_maze(grid, rng)
	_connect_regions(grid, rng)
	
	return grid


func _generate_maze(grid: Array, rng: RandomNumberGenerator):
	var dirs = [
		Vector2i(0, -2), Vector2i(0, 2), Vector2i(-2, 0), Vector2i(2, 0)
	]
	
	for x in range(1, level_size.x-1, 2):
		for y in range(1, level_size.y-1, 2):
			if _can_start_maze(grid, x, y):
				_carve_lane(Vector2i(x, y), grid, rng, dirs)


func _can_start_maze(grid: Array, x: int, y: int) -> bool:
	if grid[x][y] != 0: return false

	for dx in range(-1, 2):
		for dy in range(-1, 2):
			var nx = x + dx
			var ny = y + dy
			if nx >= 0 and nx < level_size.x and ny >= 0 and ny < level_size.y:
				if grid[nx][ny] == 1:
					return false

	return true


func _carve_lane(start_pos: Vector2i, grid: Array, rng: RandomNumberGenerator, dirs: Array):
	var stack = [start_pos]
	grid[start_pos.x][start_pos.y] = 1

	while stack.size() > 0:
		var pos = stack.back()
		var unvisited_dirs = []

		for dir in dirs:
			var npos = pos + dir
			if npos.x > 0 and npos.x < level_size.x - 1 and npos.y > 0 and npos.y < level_size.y - 1:
				if grid[npos.x][npos.y] == 0:
					unvisited_dirs.append(dir)

		if unvisited_dirs.size() > 0:
			var chosen_dir = unvisited_dirs[rng.randi() % unvisited_dirs.size()]
			var mid_pos = pos + chosen_dir / 2
			var next_pos = pos + chosen_dir

			grid[mid_pos.x][mid_pos.y] = 1
			grid[next_pos.x][next_pos.y] = 1
			stack.append(next_pos)
		else:
			stack.pop_back()


func _connect_regions(grid: Array, rng: RandomNumberGenerator):
	var potential_holes = []
	# Szukamy ścian, po których przeciwnych stronach jest podłoga (idealne miejsce na przejście)
	for x in range(1, level_size.x - 1):
		for y in range(1, level_size.y - 1):
			if grid[x][y] == 0:
				var is_horiz = grid[x-1][y] == 1 and grid[x+1][y] == 1 and grid[x][y-1] == 0 and grid[x][y+1] == 0
				var is_vert = grid[x][y-1] == 1 and grid[x][y+1] == 1 and grid[x-1][y] == 0 and grid[x+1][y] == 0
				
				if is_horiz or is_vert:
					potential_holes.append(Vector2i(x, y))

	# Własna implementacja tasowania Fisher-Yates wspierająca przekazany RNG dla bezpieczeństwa wątków
	for i in range(potential_holes.size() - 1, 0, -1):
		var j = rng.randi() % (i + 1)
		var temp = potential_holes[i]
		potential_holes[i] = potential_holes[j]
		potential_holes[j] = temp

	# Przekształcamy ok. 15% takich miejsc w otwarte drzwi (pętle urozmaicające eksplorację)
	var holes_to_punch = max(1, int(potential_holes.size() * 0.15))
	for i in range(min(holes_to_punch, potential_holes.size())):
		var p = potential_holes[i]
		grid[p.x][p.y] = 1


func _eval_fit():
	#for pop in pops:
		#pop.fitness = _calc_fit(pop.grid)
	var task_id = WorkerThreadPool.add_group_task(
		func(index):
			pops[index].fitness = _calc_fit(pops[index].grid),
		pops.size()
	)
	WorkerThreadPool.wait_for_group_task_completion(task_id)


func _calc_fit(grid):
	var total_size = level_size.x * level_size.y
	var floor_count: int = 0
	var acces_count: int = 0
	var isolation_penalty: int = 0
	
	var start_pos := Vector2.ZERO
	var start_found: bool = false
	
	for x in range(0.25 * level_size.x, 0.75 * level_size.x):
		for y in range(0.25 * level_size.y, 0.75 * level_size.y):
			if grid[x][y] == 1:
				start_pos = Vector2i(x, y)
				start_found = true
				break
		if start_found:
			break

	if not start_found:
		return 0.0

	var visited := {}
	var stack: Array[Vector2i] = [start_pos]
	visited[start_pos] = true
	
	var dirs = [
		Vector2i.UP, Vector2i.DOWN, Vector2i.LEFT, Vector2i.RIGHT
	]
	
	while stack.size() > 0:
		var pos = stack.pop_back()
		acces_count += 1
		
		for dir in dirs:
			var new_pos = pos + dir
			if (
				new_pos.x >= 0 and 
				new_pos.x <= level_size.x - 1 and 
				new_pos.y >= 0 and 
				new_pos.y <= level_size.y - 1 and 
				grid[new_pos.x][new_pos.y] == 1 and 
				not visited.has(Vector2i(new_pos.x, new_pos.y))
			):
				visited[new_pos] = true
				stack.append(new_pos)

	for x in level_size.x:
		for y in level_size.y:
			if grid[x][y] == 1:
				floor_count += 1
				if count_walls(x, y, 1, grid) >= 7:
					isolation_penalty += 1

	var conn_ratio = acces_count / floor_count
	var floor_ratio = floor_count / total_size
	var floor_dev = abs(floor_ratio - floor_target)

	var fitness = max(
		conn_ratio * 3.0 + ((1 - floor_dev) * 1) - (isolation_penalty / total_size) * 10.0,
		0.0
	)

	return fitness


func _sel_and_breed() -> Array[Pop]:
	var new_pops: Array[Pop] = []
	new_pops.resize(pop_size)
	
	pops.sort_custom(func(a, b): return a.fitness > b.fitness)

	for i in elit_count:
		var elite = Pop.new()
		elite.grid = pops[i].grid.duplicate(true)
		elite.fitness = pops[i].fitness
		new_pops[i] = elite

	var task_id = WorkerThreadPool.add_group_task(
		func(index):
			var parent1 = _rank_selection()
			var parent2 = _rank_selection()
			var child_idx = index + elit_count
			
			var child = Pop.new()

			if randf() < cross_rate:
				child.grid = _cross(parent1.grid, parent2.grid)
			else:
				child.grid = parent1.grid.duplicate(true)

			_mutate(child.grid)
			new_pops[child_idx] = child,
		pop_size - elit_count
	)
	WorkerThreadPool.wait_for_group_task_completion(task_id)

	#while new_pops.size() < pop_size:
		#var parent1 = _rank_selection()
		#var parent2 = _rank_selection()
#
		#var child = Pop.new()
#
		#if randf() < cross_rate:
			#child.grid = _cross(parent1.grid, parent2.grid)
		#else:
			#child.grid = parent1.grid.duplicate(true)
#
		#_mutate(child.grid)
		#new_pops.append(child)

	return new_pops


func _rank_selection() -> Pop:
	var rank_sum = (pop_size * (pop_size + 1)) / 2
	var pick = randf() * rank_sum
	var curr_sum = 0

	for i in range(pop_size):
		curr_sum += (pop_size - i)
		if curr_sum >= pick:
			return pops[i]

	return pops[0]


func _cross(grid1: Array, grid2: Array) -> Array:
	var child_grid = grid1.duplicate(true)

	var split_x = randi() % level_size.x

	for x in range(split_x, level_size.x):
		for y in range(level_size.y):
			child_grid[x][y] = grid2[x][y]

	return child_grid


func _mutate(grid: Array):
	if randf() < mut_rate:
		var rx = randi() % (level_size.x - 2)
		var ry = randi() % (level_size.y - 2)

		for i in range(2):
			for j in range(2):
				grid[rx+i][ry+j] = 1
"

