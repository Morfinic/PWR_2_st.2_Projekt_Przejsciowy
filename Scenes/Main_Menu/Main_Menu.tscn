[sub_resource type="GDScript" id="GDScript_ykkbm"]
script/source = "extends Control


@export var after_start_scene: PackedScene


func _on_start_pressed() -> void:
	SceneChanger.change_scene(after_start_scene)


func _on_exit_pressed() -> void:
	get_tree().quit()
"

