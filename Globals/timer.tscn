[sub_resource type="GDScript" id="GDScript_nws1w"]
script/source = "extends Node


var startFunc


func start():
	startFunc = Time.get_ticks_usec()


func stop(algName: String):
	var stopFunc = Time.get_ticks_usec()
	var duration = (stopFunc - startFunc) / 1000.0
	
	return duration


func measure(function: Callable, algName: String = \"<>\", level_size := Vector2i(), is_testing := false):
	start()
	var result = function.call()
	var time = stop(algName)
	
	if is_testing:
		_save_to_file(algName, level_size, time, result)
	Similiar.map_arrays.append(result)
	
	return result


func _save_to_file
(
	algName: String, level_size: Vector2i, 
	time: float, map_data: Variant
):
	var path = Resources.data_folder + \"/Pomiary/%s_%dx%d.csv\" % [algName, level_size.x, level_size.y]
	
	if not DirAccess.dir_exists_absolute(Resources.data_folder + \"/Pomiary\"):
		DirAccess.make_dir_recursive_absolute(Resources.data_folder + \"/Pomiary\")
	
	var open_ratio: float = _calc_open_space_ratio(map_data, level_size)
	var connectivity: Dictionary = _calc_conn(map_data)
	var entropy := calculate_entropy(map_data)
	
	var file_exists = FileAccess.file_exists(path)
	var file = FileAccess.open(path, FileAccess.READ_WRITE if file_exists else FileAccess.WRITE)
	
	if not file_exists:
		file.store_line(\"Czas generacji;Liczba komorek;Otwarte komorki;OSR;OSR%;Spojnosc;Liczba sektorow;Rozmiar najwiekszego sektora;Pokrycie;Pokrycie%;Entropia (max ~3.17 b); Entropia (znormalizowana)\")
	
	file.seek_end()
	file.store_line(
		\"%.4f;%d;%d;%.4f;%.1f%%;%s;%d;%d;%.4f;%.1f%%;%.4f;%.4f\" %
		[time, level_size.x * level_size.y, map_data.size(), open_ratio, open_ratio * 100.0,
		\"TAK\" if connectivity[\"connected\"] else \"NIE\", connectivity[\"components\"], connectivity[\"largest_component\"],
		connectivity[\"connectivity_ratio\"], connectivity[\"connectivity_ratio\"] * 100.0, entropy[0], entropy[1]]
	)
	file.close()
	

func _calc_open_space_ratio(cells: Array, level_size: Vector2i) -> float:
	var total := level_size.x * level_size.y
	if total == 0:
		return 0.0
	
	return float(cells.size()) / float(total)


func _calc_conn(cells: Array) -> Dictionary:
	if cells.is_empty():
		return {
			\"connected\": true,
			\"components\": 0,
			\"largest_component\": 0,
			\"connectivity_ratio\": 1.0
		}
	
	var cell_map := {}
	var typed_cells: Array[Vector2i] = []
	
	for c in cells:
		var v_int = Vector2i(c)
		cell_map[v_int] = true
		typed_cells.append(v_int)
	
	var visited := {}
	var component_list: Array[int] = []
	
	for start_cell in typed_cells:
		if visited.has(start_cell):
			continue
		
		var current_comp_size = 0
		var stack: Array[Vector2i] = [start_cell]
		visited[start_cell] = true
		
		while not stack.is_empty():
			var cur = stack.pop_back()
			current_comp_size += 1
			
			for neighbour in _four_neighbors(cur):
				if cell_map.has(neighbour) and not visited.has(neighbour):
					visited[neighbour] = true
					stack.append(neighbour)
		
		component_list.append(current_comp_size)

	var total_comps =  component_list.size()
	var largest = component_list.max() if total_comps > 0 else 0

	return {
			\"connected\": total_comps == 1,
			\"components\": total_comps,
			\"largest_component\": largest,
			\"connectivity_ratio\": float(largest) / float(typed_cells.size())
		}


func _four_neighbors(cell: Vector2i) -> Array:
	return [
		cell + Vector2i.UP,
		cell + Vector2i.DOWN,
		cell + Vector2i.LEFT,
		cell + Vector2i.RIGHT,
	]
	

func _eight_neighbors(cell: Vector2i) -> Array:
	return [
		cell + Vector2i.UP, cell + Vector2i.DOWN,
		cell + Vector2i.LEFT, cell + Vector2i.RIGHT,
		cell + Vector2i(1, 1), cell + Vector2i(1, -1),
		cell + Vector2i(-1, 1), cell + Vector2i(-1, -1)
	]


func calculate_entropy(cells: Array) -> Array[float]:
	if cells.is_empty():
		return [0.0, 0.0]

	var cell_set: Dictionary = {}
	for c in cells:
		cell_set[Vector2i(c)] = true

	var histogram: Dictionary = {}
	
	for cell in cells:
		var pattern_id := 0
		var bit_idx := 0
		
		for dy in range(-1, 2):
			for dx in range(-1, 2):
				var check_pos = Vector2i(cell.x + dx, cell.y + dy)
				
				if cell_set.has(check_pos):
					pattern_id |= (1 << bit_idx)
				
				bit_idx += 1
		
		histogram[pattern_id] = histogram.get(pattern_id, 0) + 1

	# Shannon H = -Σ p(x) * log2(p(x))
	var total:   float = float(cells.size())
	var entropy: float = 0.0
	
	for cnt in histogram.values():
		var p: float = cnt / total
		if p > 0.0:
			entropy -= p * (log(p) / log(2.0))
	
	return [entropy, entropy / 9]
"

