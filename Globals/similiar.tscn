[gd_scene format=3 uid="uid://cxl267dq6aovy"]

[sub_resource type="GDScript" id="GDScript_35fqd"]
script/source = "extends Node


var alg_name: String = \"\"
var map_size := Vector2i(0, 0)
var map_arrays = []


func reset():
	alg_name = \"\"
	map_size = Vector2i(0, 0)
	map_arrays = []


func _map_to_binary_string(map_array: Array) -> String:
	var lookup := {}
	for cell in map_array:
		lookup[Vector2i(cell)] = true

	var chars := PackedStringArray()
	
	for y in range(map_size.y):
		for x in range(map_size.x):
			if lookup.has(Vector2i(x, y)):
				chars.append(\"1\")
			else:
				chars.append(\"0\")
				
	return \"\".join(chars)


func calculate_ncd(map_a: Array, map_b: Array) -> float:
	var str_a = _map_to_binary_string(map_a)
	var str_b = _map_to_binary_string(map_b)
	
	var bytes_a: PackedByteArray = str_a.to_utf8_buffer()
	var bytes_b: PackedByteArray = str_b.to_utf8_buffer()
	
	var c_a = float(bytes_a.compress(FileAccess.COMPRESSION_ZSTD).size())
	var c_b = float(bytes_b.compress(FileAccess.COMPRESSION_ZSTD).size())
	
	var bytes_combined := PackedByteArray()
	bytes_combined.append_array(bytes_a)
	bytes_combined.append_array(bytes_b)
	var c_ab = float(bytes_combined.compress(FileAccess.COMPRESSION_ZSTD).size())
	
	var ncd_value = (c_ab - min(c_a, c_b)) / max(c_a, c_b)
	
	# min(ncd_value, 1.0)
	return ncd_value


func analyze_algorithm_diversity():
	var ncd_results = []
	
	for i in range(1, map_arrays.size()):
		var dist = calculate_ncd(map_arrays[i - 1], map_arrays[i])
		ncd_results.append(dist)
	
	#var total = 0.0
	#for val in ncd_results: total += val
	#var avg_ncd = total / ncd_results.size()
	
	_save_summary_to_csv(ncd_results)
	AStar.alg_name = alg_name
	AStar.map_size = map_size
	AStar.map_arrays = map_arrays
	reset()

func _save_summary_to_csv(data: Array):
	var path = Resources.data_folder + \"/Pomiary/similiarity_report_%s_%dx%d.csv\" % [alg_name, map_size.x, map_size.y]
	var file_exists = FileAccess.file_exists(path)
	var file = FileAccess.open(path, FileAccess.READ_WRITE if file_exists else FileAccess.WRITE)
	
	if not file_exists:
		file.store_line(\"Srednia_NCD;Zroznicowanie%\")
	
	file.seek_end()
	for value in data:
		file.store_line(\"%.4f;%.1f%%\" % [value, value * 100.0])
	file.close()
"

